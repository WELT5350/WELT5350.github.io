---
import InlineSearch from './InlineSearch.astro';

const pathname = Astro.url.pathname;
const isActive = (base: string) => {
  if (base === '/') return pathname === '/';
  return pathname.startsWith(base);
};
const navItems = [
  { href: '/', label: '首页', base: '/' },
  { href: '/posts', label: '文章', base: '/posts' },
  { href: '/about', label: '关于', base: '/about' },
  { href: '/links', label: '友链', base: '/links' },
  { href: '/guestbook', label: '留言板', base: '/guestbook' },
];
---

<nav id="top-nav" class="glass-nav sticky top-0 z-50 border-x-0 border-t-0 shadow-md shadow-black/10 transition-colors duration-300">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex min-w-0 items-center gap-3 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500">
        <img class="block h-8 w-8 rounded-full ring-2 ring-blue-100 dark:hidden" src="/avatar.webp" alt="WELT 头像" width="32" height="32" fetchpriority="high" />
        <img class="hidden h-8 w-8 rounded-full ring-2 ring-blue-900 dark:block" src="/avatar-dark.webp" alt="WELT 头像" width="32" height="32" fetchpriority="high" />
        <span class="bg-gradient-to-r from-blue-600 to-blue-400 bg-clip-text text-lg font-bold tracking-tight text-transparent">WELT</span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <ul class="flex items-center gap-1" aria-label="主导航">
          {navItems.map(({ href, label, base }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(base) ? 'page' : undefined}
                class={`rounded-lg px-3 py-2 text-sm transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 ${isActive(base) ? 'bg-blue-50/80 font-semibold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300' : 'text-slate-600 hover:bg-blue-50/70 hover:text-blue-700 dark:text-slate-300 dark:hover:bg-blue-950/40 dark:hover:text-blue-300'}`}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <InlineSearch />
        <button data-theme-toggle type="button" class="ml-1 rounded-lg p-2 text-slate-500 transition-colors duration-200 hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-slate-400 dark:hover:bg-blue-950/40 dark:hover:text-blue-300" aria-label="切换主题">
          <svg aria-hidden="true" class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
          <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 0 1 0z"/></svg>
        </button>
      </div>

      <div class="flex items-center gap-1 md:hidden">
        <button data-mobile-search-toggle type="button" class="rounded-lg p-2 text-slate-500 transition-colors duration-200 hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-slate-400 dark:hover:bg-blue-950/40 dark:hover:text-blue-300" aria-controls="mobile-search-panel" aria-expanded="false" aria-label="搜索文章">
          <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5" stroke-width="1.8" />
            <path stroke-linecap="round" stroke-width="1.8" d="m16 16 4 4" />
          </svg>
        </button>
        <button data-theme-toggle type="button" class="rounded-lg p-2 text-slate-500 transition-colors duration-200 hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-slate-400 dark:hover:bg-blue-950/40 dark:hover:text-blue-300" aria-label="切换主题">
          <svg aria-hidden="true" class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
          <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 0 1 0z"/></svg>
        </button>
        <button id="menu-toggle" type="button" class="rounded-lg p-2 text-slate-600 transition-colors duration-200 hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-slate-300 dark:hover:bg-blue-950/40 dark:hover:text-blue-300" aria-controls="mobile-menu" aria-expanded="false" aria-label="打开导航">
          <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-search-panel" class="mobile-search-panel border-t border-white/30 dark:border-slate-600/25 md:hidden" data-state="closed">
    <InlineSearch mobile />
  </div>

  <div id="mobile-menu" class="glass-nav hidden border-x-0 border-b-0 px-4 py-3 md:hidden">
    <ul class="grid grid-cols-2 gap-1" aria-label="主导航">
      {navItems.map(({ href, label, base }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(base) ? 'page' : undefined}
            class={`block rounded-lg px-3 py-2 text-sm transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 ${isActive(base) ? 'bg-blue-50 font-semibold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300' : 'text-slate-600 hover:bg-blue-50 dark:text-slate-300 dark:hover:bg-blue-950/40'}`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script is:inline>
  (function () {
    function initialiseNavbar() {
      window.__weltNavbarCleanup?.();
      var controller = new AbortController();
      var signal = controller.signal;

      document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
        button.addEventListener('click', function () {
          var html = document.documentElement;
          html.classList.toggle('dark');
          localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
          window.__weltSyncThemeColor?.();
        }, { signal: signal });
      });

      var menuToggle = document.getElementById('menu-toggle');
      var mobileMenu = document.getElementById('mobile-menu');
      if (menuToggle && mobileMenu) {
        menuToggle.addEventListener('click', function () {
          var isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isOpen));
          menuToggle.setAttribute('aria-label', isOpen ? '打开导航' : '关闭导航');
          mobileMenu.classList.toggle('hidden', isOpen);
        }, { signal: signal });
      }

      window.__weltNavbarCleanup = function () { controller.abort(); };
    }

    function updateNavigationSurface() {
      var nav = document.getElementById('top-nav');
      if (nav) nav.classList.toggle('nav-solid', window.scrollY > 10);
    }

    if (!window.__weltNavbarLifecycleBound) {
      window.__weltNavbarLifecycleBound = true;
      window.addEventListener('scroll', updateNavigationSurface, { passive: true });
      document.addEventListener('astro:page-load', function () {
        initialiseNavbar();
        updateNavigationSurface();
      });
    }

    initialiseNavbar();
    updateNavigationSurface();
  })();
</script>

<style is:global>
  #top-nav.nav-solid {
    background-color: var(--glass-sub-hover) !important;
    border-bottom-color: var(--glass-border-strong) !important;
  }
  .dark #top-nav.nav-solid {
    background-color: var(--glass-sub-hover) !important;
    border-bottom-color: var(--glass-border-strong) !important;
  }
</style>
