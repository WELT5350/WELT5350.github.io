---
import { getCollection } from 'astro:content';
import { getPublishedPosts, sortPostsByDate } from '../lib/posts';

const posts = sortPostsByDate(getPublishedPosts(await getCollection('posts')));
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags || [],
  date: post.data.pubDate.toISOString(),
  href: `/posts/${post.id}`,
}));
---

<div id="site-search-dialog" data-search-dialog data-search-index={JSON.stringify(searchIndex)} hidden>
  <div data-search-backdrop class="fixed inset-0 z-[70] bg-slate-950/40 p-4 backdrop-blur-sm sm:flex sm:items-start sm:justify-center sm:pt-[12vh]">
    <section class="glass-sub mx-auto w-full max-w-2xl overflow-hidden rounded-2xl shadow-2xl shadow-slate-950/20" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
      <div class="flex items-center gap-3 border-b border-white/35 px-4 py-3 dark:border-slate-600/35">
        <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="6.5" stroke-width="1.8" />
          <path stroke-linecap="round" stroke-width="1.8" d="m16 16 4 4" />
        </svg>
        <label id="site-search-title" class="sr-only" for="site-search-input">搜索文章</label>
        <input id="site-search-input" data-search-input type="text" inputmode="search" role="searchbox" autocomplete="off" placeholder="搜索标题、摘要或标签…" class="min-w-0 flex-1 bg-transparent text-sm text-gray-900 outline-none placeholder:text-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-gray-100 dark:placeholder:text-gray-400" aria-controls="site-search-results" aria-autocomplete="list" />
        <kbd class="hidden rounded-md border border-slate-300/70 px-1.5 py-0.5 text-[10px] font-medium text-slate-500 sm:inline dark:border-slate-600 dark:text-slate-300">ESC</kbd>
        <button data-search-close type="button" class="rounded-lg p-1.5 text-gray-500 transition-colors hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-gray-400 dark:hover:bg-blue-950/40 dark:hover:text-blue-300" aria-label="关闭搜索">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </div>
      <div id="site-search-results" data-search-results class="max-h-[min(62vh,32rem)] overflow-y-auto overscroll-contain p-2" role="listbox" aria-label="搜索结果">
        <p data-search-hint class="px-3 py-8 text-center text-sm text-gray-500 dark:text-gray-400">输入关键词，搜索文章标题、摘要或标签。</p>
      </div>
      <p class="border-t border-white/35 px-4 py-2 text-[10px] text-gray-500 dark:border-slate-600/35 dark:text-gray-400">↑↓ 选择　Enter 打开　Esc 关闭</p>
    </section>
  </div>
</div>

<script src="../scripts/search-dialog.ts"></script>
