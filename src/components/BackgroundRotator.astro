---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getBackgroundTone } from '../lib/backgroundTone';

const backgroundModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/backgrounds/*.{avif,webp,png,jpg,jpeg}', {
  eager: true,
});
const backgroundOptions = await Promise.all(
  Object.entries(backgroundModules)
    .sort(([left], [right]) => left.localeCompare(right))
    .map(async ([sourcePath, module]) => {
      const [optimized, tone] = await Promise.all([
        getImage({
          src: module.default,
          width: 1920,
          format: 'webp',
          quality: 72,
        }),
        getBackgroundTone(sourcePath),
      ]);

      return { src: optimized.src, tone };
    }),
);
---

<script is:inline define:vars={{ backgroundOptions }}>
  function applyDailyBackground(target) {
    if (backgroundOptions.length === 0) return;

    const today = new Date();
    const dayNumber = Math.floor(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) / 86_400_000);
    const selected = backgroundOptions[dayNumber % backgroundOptions.length];

    if (selected) {
      target.style.setProperty('--site-background-image', `url("${selected.src}")`);
      target.dataset.backgroundTone = selected.tone;
    }
  }

  applyDailyBackground(document.documentElement);

  document.addEventListener('astro:before-swap', (event) => {
    applyDailyBackground(event.newDocument.documentElement);
  });
</script>

<div
  class="glass-background"
  aria-hidden="true"
  transition:persist
></div>
