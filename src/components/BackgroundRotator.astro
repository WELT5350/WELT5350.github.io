---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const backgroundModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/backgrounds/*.{avif,webp,png,jpg,jpeg}', {
  eager: true,
});
const backgroundOptions = await Promise.all(
  Object.entries(backgroundModules)
    .sort(([left], [right]) => left.localeCompare(right))
    .map(async ([, module]) => {
      const optimized = await getImage({
        src: module.default,
        width: 1920,
        format: 'webp',
        quality: 72,
      });

      return optimized.src;
    }),
);
---

<script is:inline define:vars={{ backgroundOptions }}>
  function selectRefreshBackground() {
    if (backgroundOptions.length === 0) return;

    let previousIndex = -1;
    try {
      previousIndex = Number(sessionStorage.getItem('welt-background-index'));
    } catch {
      // 背景轮换在禁用会话存储时仍可用，只是不保证避免连续重复。
    }

    let nextIndex = Math.floor(Math.random() * backgroundOptions.length);
    if (backgroundOptions.length > 1 && nextIndex === previousIndex) {
      nextIndex = (nextIndex + 1 + Math.floor(Math.random() * (backgroundOptions.length - 1))) % backgroundOptions.length;
    }

    try {
      sessionStorage.setItem('welt-background-index', String(nextIndex));
    } catch {
      // 会话存储不可用时不影响本次背景选择。
    }

    return backgroundOptions[nextIndex];
  }

  const selectedBackground = selectRefreshBackground();

  function applySelectedBackground(target) {
    if (!selectedBackground) return;

    target.style.setProperty('--site-background-image', `url("${selectedBackground}")`);
  }

  applySelectedBackground(document.documentElement);

  document.addEventListener('astro:before-swap', (event) => {
    applySelectedBackground(event.newDocument.documentElement);
  });
</script>

<div
  class="glass-background"
  aria-hidden="true"
  transition:persist
></div>
