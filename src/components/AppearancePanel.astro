---
interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const panelId = mobile ? 'appearance-panel-mobile' : 'appearance-panel-desktop';
---

<div class:list={['appearance-control', mobile && 'appearance-control-mobile']}>
  <button
    data-appearance-toggle
    type="button"
    class="appearance-toggle"
    aria-controls={panelId}
    aria-expanded="false"
    aria-label="调整阅读外观"
    title="阅读外观"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3a9 9 0 1 0 9 9c0-1.1-.2-2.15-.58-3.12a5 5 0 0 1-6.3 6.3A9 9 0 0 0 12 3Z" />
      <circle cx="7.5" cy="9" r=".7" fill="currentColor" stroke="none" />
      <circle cx="10.5" cy="6.6" r=".7" fill="currentColor" stroke="none" />
      <circle cx="14.1" cy="6.8" r=".7" fill="currentColor" stroke="none" />
    </svg>
  </button>

  <section id={panelId} class="appearance-panel" data-appearance-panel hidden aria-label="阅读外观">
    <div class="appearance-panel-heading">
      <div>
        <p>READING LAYER</p>
        <h2>阅读外观</h2>
      </div>
      <button data-appearance-reset type="button" class="appearance-reset" title="恢复本站推荐" aria-label="恢复本站推荐">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 6v5h-5M4 18v-5h5M18.4 10A6.7 6.7 0 0 0 6.9 7.1L4 10m1.6 4A6.7 6.7 0 0 0 17.1 16.9L20 14" /></svg>
      </button>
    </div>

    <label class="appearance-range">
      <span><span>背景柔化</span><output data-appearance-output="blur">0 px</output></span>
      <input data-appearance-input="blur" type="range" min="0" max="24" step="1" value="0" aria-label="调整背景柔化程度" />
    </label>
    <label class="appearance-range">
      <span><span>壁纸显眼</span><output data-appearance-output="backgroundOpacity">100%</output></span>
      <input data-appearance-input="backgroundOpacity" type="range" min="12" max="100" step="1" value="100" aria-label="调整壁纸显眼程度" />
    </label>
    <label class="appearance-range">
      <span><span>卡片不透明度</span><output data-appearance-output="cardOpacity">推荐</output></span>
      <input data-appearance-input="cardOpacity" type="range" min="0" max="100" step="1" value="20" aria-label="调整卡片不透明度" />
    </label>

    <p class="appearance-note">壁纸与卡片独立调整；最高档适合高对比壁纸。</p>
  </section>
</div>

<script is:inline>
  (function () {
    var storageKey = 'welt-reading-appearance';
    var defaults = { blur: 0, backgroundOpacity: 100, cardOpacity: 20 };

    function clamp(value, minimum, maximum) {
      return Math.min(maximum, Math.max(minimum, Number(value) || 0));
    }

    function readSettings() {
          try {
            var saved = JSON.parse(localStorage.getItem(storageKey) || 'null') || {};
            return {
          blur: clamp(saved.blur ?? defaults.blur, 0, 24),
          backgroundOpacity: clamp(saved.backgroundOpacity ?? defaults.backgroundOpacity, 12, 100),
          cardOpacity: clamp(saved.cardOpacity ?? defaults.cardOpacity, 0, 100),
        };
      } catch {
        return { ...defaults };
      }
    }

    function saveSettings(settings) {
      try { localStorage.setItem(storageKey, JSON.stringify(settings)); } catch {}
    }

    function updateControls(settings) {
      document.querySelectorAll('[data-appearance-input]').forEach(function (input) {
        var key = input.getAttribute('data-appearance-input');
        input.value = String(settings[key]);
      });
      document.querySelectorAll('[data-appearance-output]').forEach(function (output) {
        var key = output.getAttribute('data-appearance-output');
        if (key === 'blur') output.textContent = `${settings.blur} px`;
        if (key === 'backgroundOpacity') output.textContent = `${settings.backgroundOpacity}%`;
        if (key === 'cardOpacity') output.textContent = settings.cardOpacity === defaults.cardOpacity ? '推荐' : `${settings.cardOpacity}%`;
      });
    }

    function closePanels() {
      document.querySelectorAll('[data-appearance-panel]').forEach(function (panel) { panel.hidden = true; });
      document.querySelectorAll('[data-appearance-toggle]').forEach(function (toggle) { toggle.setAttribute('aria-expanded', 'false'); });
    }

    function initialiseAppearancePanel() {
      window.__weltAppearanceCleanup?.();
      var controller = new AbortController();
      var signal = controller.signal;
      var settings = window.__weltReadAppearance?.() || readSettings();
      updateControls(settings);

      document.querySelectorAll('[data-appearance-toggle]').forEach(function (toggle) {
        toggle.addEventListener('click', function () {
          var panel = document.getElementById(toggle.getAttribute('aria-controls'));
          var willOpen = panel?.hidden !== false;
          closePanels();
          if (panel && willOpen) {
            panel.hidden = false;
            toggle.setAttribute('aria-expanded', 'true');
          }
        }, { signal: signal });
      });

      document.querySelectorAll('[data-appearance-input]').forEach(function (input) {
        input.addEventListener('input', function () {
          settings = {
            blur: Number(document.querySelector('[data-appearance-input="blur"]')?.value ?? settings.blur),
            backgroundOpacity: Number(document.querySelector('[data-appearance-input="backgroundOpacity"]')?.value ?? settings.backgroundOpacity),
            cardOpacity: Number(document.querySelector('[data-appearance-input="cardOpacity"]')?.value ?? settings.cardOpacity),
          };
          window.__weltApplyAppearance?.(settings);
          saveSettings(settings);
          updateControls(settings);
        }, { signal: signal });
      });

      document.querySelectorAll('[data-appearance-reset]').forEach(function (button) {
        button.addEventListener('click', function () {
          settings = { ...defaults };
          try { localStorage.removeItem(storageKey); } catch {}
          window.__weltApplyAppearance?.(settings);
          updateControls(settings);
        }, { signal: signal });
      });

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        var openToggle = document.querySelector('[data-appearance-toggle][aria-expanded="true"]');
        if (!openToggle) return;
        closePanels();
        openToggle.focus();
      }, { signal: signal });

      document.addEventListener('pointerdown', function (event) {
        if (!(event.target instanceof Node) || event.target.closest?.('.appearance-control')) return;
        closePanels();
      }, { signal: signal });

      window.__weltAppearanceCleanup = function () { controller.abort(); };
    }

    if (!window.__weltAppearancePanelLifecycleBound) {
      window.__weltAppearancePanelLifecycleBound = true;
      document.addEventListener('astro:page-load', initialiseAppearancePanel);
    }

    initialiseAppearancePanel();
  })();
</script>
