<button data-focus-reading-toggle type="button" class="focus-reading-toggle" aria-pressed="false" aria-label="开启专注阅读">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5.8A2.8 2.8 0 0 1 6.8 3H20v15.2A2.8 2.8 0 0 0 17.2 21H4V5.8Z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7.5h8M8 11h6" />
  </svg>
  <span>专注阅读</span>
</button>

<script is:inline>
  (function () {
    function setFocusReading(enabled) {
      document.documentElement.classList.toggle('focus-reading', enabled);
      document.querySelectorAll('[data-focus-reading-toggle]').forEach(function (button) {
        button.setAttribute('aria-pressed', String(enabled));
        button.setAttribute('aria-label', enabled ? '关闭专注阅读' : '开启专注阅读');
        button.querySelector('span').textContent = enabled ? '退出专注' : '专注阅读';
      });
    }

    if (!window.__weltFocusReadingBound) {
      window.__weltFocusReadingBound = true;
      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;
        var button = target.closest('[data-focus-reading-toggle]');
        if (!button) return;
        setFocusReading(!document.documentElement.classList.contains('focus-reading'));
      });
      document.addEventListener('astro:page-load', function () { setFocusReading(false); });
    }

    setFocusReading(false);
  })();
</script>
