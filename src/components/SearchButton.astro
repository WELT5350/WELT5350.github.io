---
const { mobile = false } = Astro.props;
---

<button
  data-search-trigger
  type="button"
  class:list={[
    'rounded-lg p-2 text-slate-500 transition-colors duration-200 hover:bg-blue-50/70 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-slate-400 dark:hover:bg-blue-950/40 dark:hover:text-blue-300',
    !mobile && 'ml-1',
  ]}
  aria-controls="site-search-dialog"
  aria-expanded="false"
  aria-label="搜索文章（Ctrl 或 Command 加 K）"
  title="搜索文章（Ctrl/⌘ K）"
>
  <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <circle cx="11" cy="11" r="6.5" stroke-width="1.8" />
    <path stroke-linecap="round" stroke-width="1.8" d="m16 16 4 4" />
  </svg>
</button>
