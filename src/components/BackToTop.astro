---

<button id="back-to-top" type="button" class="fixed bottom-8 right-8 z-50 w-10 h-10 rounded-full bg-blue-500 text-white shadow-lg shadow-blue-500/20 opacity-0 pointer-events-none transition-[opacity,background-color,box-shadow,transform] duration-300 hover:bg-blue-600 hover:shadow-blue-500/30 hover:-translate-y-0.5 cursor-pointer" aria-label="回到顶部">
  <svg aria-hidden="true" class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
  </svg>
</button>

<script>
  const lifecycleWindow = window as typeof window & {
    __weltBackToTopCleanup?: () => void;
    __weltBackToTopLifecycleBound?: boolean;
  };

  function initialiseBackToTop() {
    lifecycleWindow.__weltBackToTopCleanup?.();
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    const controller = new AbortController();
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, { signal: controller.signal });
    lifecycleWindow.__weltBackToTopCleanup = () => controller.abort();
  }

  function updateBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    btn.classList.toggle('opacity-0', window.scrollY <= 400);
    btn.classList.toggle('pointer-events-none', window.scrollY <= 400);
    btn.classList.toggle('opacity-100', window.scrollY > 400);
  }

  if (!lifecycleWindow.__weltBackToTopLifecycleBound) {
    lifecycleWindow.__weltBackToTopLifecycleBound = true;
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    document.addEventListener('astro:page-load', () => {
      initialiseBackToTop();
      updateBackToTop();
    });
  }

  initialiseBackToTop();
  updateBackToTop();
</script>
