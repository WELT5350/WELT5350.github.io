---
import type { SiteArchiveStats } from '../lib/posts';
import { formatCompactNumber } from '../lib/posts';

const { stats } = Astro.props as { stats: SiteArchiveStats };
const latestDate = stats.latestPost
  ? stats.latestPost.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })
  : '暂无记录';
---

<section class="archive-sheet glass-sub mb-8 rounded-xl p-5" aria-labelledby="site-archive-title">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="archive-kicker">SITE RECORD</p>
      <h2 id="site-archive-title" class="mt-1 text-base font-semibold text-[var(--glass-ink)]">写作足迹</h2>
      <p class="mt-1 text-xs leading-relaxed text-[var(--glass-muted)]">由公开文章生成的本站写作记录，不包含访客行为。</p>
    </div>
    <span class="archive-stamp" aria-label="本地档案">LOCAL</span>
  </div>

  <dl class="archive-ledger mt-5 grid grid-cols-2 sm:grid-cols-4">
    <div>
      <dt>公开文章</dt>
      <dd>{stats.postCount}<small>篇</small></dd>
    </div>
    <div>
      <dt>使用标签</dt>
      <dd>{stats.tagCount}<small>个</small></dd>
    </div>
    <div>
      <dt>累计书写</dt>
      <dd>{formatCompactNumber(stats.totalUnits)}<small>字</small></dd>
    </div>
    <div>
      <dt>最近更新</dt>
      <dd class="archive-date" title={latestDate}>{latestDate}</dd>
    </div>
  </dl>
</section>
