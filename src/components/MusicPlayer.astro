<div id="music-player" class="glass-sub rounded-xl">
  <div class="p-3">
    <div class="flex items-center gap-2.5">
      <div id="mp-icon-wrap" class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center flex-shrink-0 shadow-sm transition-shadow duration-300">
        <svg aria-hidden="true" class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1.5">
          <p id="mp-title" class="text-xs font-medium text-gray-800 dark:text-gray-200 truncate">浅滩（2024ver）</p>
          <span id="mp-index" class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500 flex-shrink-0">8/9</span>
        </div>
        <p id="mp-artist" class="text-[10px] text-gray-400 dark:text-gray-500 truncate">Lagrange_P / 海伊</p>
      </div>
      <div id="mp-bars" class="flex items-end gap-0.5 flex-shrink-0">
        <span class="mp-bar block w-0.5 rounded-full bg-blue-400 dark:bg-blue-400" style="height:4px;transition:height 0.15s ease"></span>
        <span class="mp-bar block w-0.5 rounded-full bg-blue-400 dark:bg-blue-400" style="height:4px;transition:height 0.15s ease"></span>
        <span class="mp-bar block w-0.5 rounded-full bg-blue-400 dark:bg-blue-400" style="height:4px;transition:height 0.15s ease"></span>
      </div>
    </div>

    <div class="flex items-center gap-2 mt-2 mb-1.5">
      <span id="mp-time-cur" class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500 w-7 text-right flex-shrink-0">0:00</span>
      <input id="mp-progress" class="mp-progress flex-1" type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" />
      <span id="mp-time-dur" class="text-[10px] tabular-nums text-gray-400 dark:text-gray-500 w-7 flex-shrink-0">0:00</span>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-0.5">
        <button id="mp-prev" type="button" class="p-1.5 rounded-lg text-gray-400 dark:text-gray-500 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-blue-50/40 dark:hover:bg-blue-900/30 transition-colors" aria-label="上一首" title="上一首">
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
        </button>
        <button id="mp-play-btn" type="button" class="p-1.5 rounded-lg text-blue-500 hover:bg-blue-50/40 dark:hover:bg-blue-900/30 transition-[background-color,transform] duration-200 active:scale-90" aria-label="播放" title="播放/暂停">
          <svg id="mp-play-icon" aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <button id="mp-next" type="button" class="p-1.5 rounded-lg text-gray-400 dark:text-gray-500 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-blue-50/40 dark:hover:bg-blue-900/30 transition-colors" aria-label="下一首" title="下一首">
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
        </button>
      </div>
      <div class="flex items-center gap-0.5">
        <button id="mp-mode" type="button" class="p-1 rounded-lg text-gray-400 dark:text-gray-500 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-blue-50/40 dark:hover:bg-blue-900/30 transition-colors" aria-label="顺序播放" title="顺序播放">
          <svg id="mp-mode-icon" aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <button id="mp-list-toggle" type="button" class="p-1 rounded-lg text-gray-400 dark:text-gray-500 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-blue-50/40 dark:hover:bg-blue-900/30 transition-colors" aria-label="打开歌单" title="歌单">
          <svg id="mp-list-icon" aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mp-list" class="hidden border-t border-blue-100/30 dark:border-blue-800/30">
    <div class="max-h-40 overflow-y-auto py-1" id="mp-list-items"></div>
  </div>
</div>

<audio id="mp-audio" preload="metadata" style="display:none;"></audio>
<p id="mp-status" class="sr-only" aria-live="polite"></p>

<script src="../scripts/music-player.ts"></script>
