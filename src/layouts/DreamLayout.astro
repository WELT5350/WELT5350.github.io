---
import Layout from './Layout.astro';
import BackgroundRotator from '../components/BackgroundRotator.astro';
import DreamBgm from '../components/DreamBgm.astro';
const { title, description } = Astro.props;
---

<Layout title={title} description={description} pageType="website" dream>
  <BackgroundRotator />
  <div class="glass-wash" aria-hidden="true" transition:persist></div>
  <DreamBgm />
  <main id="main-content" class="relative z-10 flex items-center justify-center px-4 py-6 sm:py-10" style="min-height: 100vh;">
    <div class="dream-card glass-main w-full max-w-2xl rounded-3xl p-6 transition-colors duration-300 sm:p-10">
      <slot />
    </div>
  </main>
  <a
    href="/"
    class="dream-exit glass-sub fixed bottom-5 left-5 z-50 inline-flex h-10 items-center gap-2 rounded-full px-4 text-xs font-medium transition-colors"
    aria-label="返回现实"
  >
    <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10" /></svg>
    返回现实
  </a>
</Layout>
