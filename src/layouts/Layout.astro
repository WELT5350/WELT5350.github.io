---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title, description, pageType = 'website' } = Astro.props;
const desc = description || '死宅 / 技术笨蛋 / 社交恐怖分子';
const image = 'https://WELT5350.github.io/avatar.jpg';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <meta property="og:title" content={title ? `${title} | 我的博客` : '我的博客'} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content={pageType} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title ? `${title} | 我的博客` : '我的博客'}</title>
    <script is:inline>
      (function () {
        const appearanceKey = 'welt-reading-appearance';
        const appearanceDefaults = { hue: 210, blur: 0, backgroundOpacity: 100, cardOpacity: 20 };
        const clamp = (value, min, max) => Math.min(max, Math.max(min, Number(value) || 0));
        window.__weltReadAppearance = function () {
          try {
            const saved = JSON.parse(localStorage.getItem(appearanceKey) || 'null') || {};
            return {
              hue: clamp(saved.hue ?? appearanceDefaults.hue, 0, 360),
              blur: clamp(saved.blur ?? appearanceDefaults.blur, 0, 24),
              backgroundOpacity: clamp(saved.backgroundOpacity ?? appearanceDefaults.backgroundOpacity, 15, 100),
              cardOpacity: clamp(saved.cardOpacity ?? appearanceDefaults.cardOpacity, 0, 100),
            };
          } catch {
            return { ...appearanceDefaults };
          }
        };
        window.__weltApplyAppearance = function (settings) {
          const root = document.documentElement;
          const hue = clamp(settings.hue, 0, 360);
          const blur = clamp(settings.blur, 0, 24);
          const backgroundOpacity = clamp(settings.backgroundOpacity, 15, 100) / 100;
          const cardOpacity = clamp(settings.cardOpacity, 0, 100) / 100;
          const dark = root.classList.contains('dark');
          const colors = dark
            ? { main: `${hue} 24% 15%`, article: `${hue} 20% 11%`, sub: `${hue} 30% 22%`, reading: `${hue} 26% 16%`, nav: `${hue} 27% 13%`, hover: `${hue} 31% 26%`, border: `${hue} 68% 78%`, minimum: [0.08, 0.78, 0.06, 0.12, 0.08, 0.10, 0.08], recommended: [0.26, 0.78, 0.18, 0.50, 0.25, 0.29, 0.20], maximum: [0.92, 0.94, 0.90, 0.94, 0.90, 0.90, 0.60] }
            : { main: `${hue} 70% 97%`, article: `${hue} 65% 98%`, sub: `${hue} 85% 99%`, reading: `${hue} 78% 98%`, nav: `${hue} 82% 99%`, hover: `${hue} 78% 96%`, border: `${hue} 85% 97%`, minimum: [0.04, 0.76, 0.02, 0.08, 0.04, 0.06, 0.10], recommended: [0.30, 0.76, 0.18, 0.42, 0.22, 0.28, 0.50], maximum: [0.94, 0.94, 0.90, 0.92, 0.90, 0.90, 0.82] };
          const alpha = (index) => {
            const [minimum, recommended, maximum] = [colors.minimum[index], colors.recommended[index], colors.maximum[index]];
            const value = cardOpacity <= 0.2
              ? minimum + (recommended - minimum) * (cardOpacity / 0.2)
              : recommended + (maximum - recommended) * ((cardOpacity - 0.2) / 0.8);
            return value.toFixed(3);
          };
          root.style.setProperty('--appearance-hue', String(hue));
          root.style.setProperty('--appearance-background-blur', `${blur}px`);
          root.style.setProperty('--appearance-background-scale', String(1.03 + blur / 350));
          root.style.setProperty('--appearance-background-opacity', String(backgroundOpacity));
          root.style.setProperty('--appearance-glass-main', `hsl(${colors.main} / ${alpha(0)})`);
          root.style.setProperty('--appearance-glass-article', `hsl(${colors.article} / ${alpha(1)})`);
          root.style.setProperty('--appearance-glass-sub', `hsl(${colors.sub} / ${alpha(2)})`);
          root.style.setProperty('--appearance-glass-reading', `hsl(${colors.reading} / ${alpha(3)})`);
          root.style.setProperty('--appearance-glass-nav', `hsl(${colors.nav} / ${alpha(4)})`);
          root.style.setProperty('--appearance-glass-sub-hover', `hsl(${colors.hover} / ${alpha(5)})`);
          root.style.setProperty('--appearance-glass-border', `hsl(${colors.border} / ${alpha(6)})`);
        };
        const savedTheme = localStorage.getItem('theme');
        const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        window.__weltApplyAppearance(window.__weltReadAppearance());
        window.__weltSyncThemeColor = function () {
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.classList.contains('dark') ? '#0a162b' : '#f8fafc');
        };
        window.__weltSyncThemeColor();
      })();
    </script>
    <script is:inline>
      if (!window.__weltRouterLifecycleBound) {
        window.__weltRouterLifecycleBound = true;
        document.addEventListener('astro:before-swap', function (event) {
          var useDark = document.documentElement.classList.contains('dark');
          event.newDocument.documentElement.classList.toggle('dark', useDark);
        });
        document.addEventListener('astro:after-swap', function () {
          window.__weltApplyAppearance?.(window.__weltReadAppearance?.());
          if (!window.location.hash) window.scrollTo(0, 0);
        });
      }
    </script>
    <ClientRouter />
    <script>
      function mountGiscus() {
        const container = document.getElementById('giscus-container');
        if (!container || container.childElementCount > 0) return;

        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', 'WELT5350/WELT5350.github.io');
        script.setAttribute('data-repo-id', 'R_kgDOSlpBSg');
        script.setAttribute('data-category', 'Guestbook');
        script.setAttribute('data-category-id', 'DIC_kwDOSlpBSs4C9uCh');
        script.setAttribute('data-mapping', 'specific');
        script.setAttribute('data-term', 'guestbook');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-input-position', 'top');
        script.setAttribute('data-theme', 'preferred_color_scheme');
        script.setAttribute('data-lang', 'zh-CN');
        script.crossOrigin = 'anonymous';
        container.appendChild(script);
      }

      document.addEventListener('astro:page-load', mountGiscus);
    </script>
  </head>
  <body class="font-sans text-gray-700 dark:text-gray-300 antialiased min-h-screen flex flex-col overflow-x-hidden bg-white dark:bg-gray-950 transition-colors duration-300">
    <slot />
  </body>
</html>
