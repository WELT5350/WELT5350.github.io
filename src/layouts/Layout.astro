---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { title, description, pageType = 'website', dream = false } = Astro.props;
const desc = description || '死宅 / 技术笨蛋 / 社交恐怖分子';
const image = 'https://WELT5350.github.io/avatar.jpg';
---

<!doctype html>
<html lang="zh-CN" data-dream={dream ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <meta property="og:title" content={title ? `${title} | 我的博客` : '我的博客'} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="WELT 头像" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content={pageType} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字体样式表非阻塞加载：先渲染系统字体，加载完成后才替换；被墙或失败时无缝回退 -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.setAttribute('media','all')" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" /></noscript>
    <title>{title ? `${title} | 我的博客` : '我的博客'}</title>
    <script is:inline>
      (function () {
        const appearanceKey = 'welt-reading-appearance';
        const appearanceDefaults = { hue: 210, blur: 0, backgroundOpacity: 100, cardOpacity: 20 };
        const clamp = (value, min, max) => Math.min(max, Math.max(min, Number(value) || 0));
        const normalizeAppearance = function (settings) {
          return {
            hue: clamp(settings?.hue ?? appearanceDefaults.hue, 0, 360),
            blur: clamp(settings?.blur ?? appearanceDefaults.blur, 0, 24),
            backgroundOpacity: clamp(settings?.backgroundOpacity ?? appearanceDefaults.backgroundOpacity, 15, 100),
            cardOpacity: clamp(settings?.cardOpacity ?? appearanceDefaults.cardOpacity, 0, 100),
          };
        };
        const readAppearance = function () {
          try {
            const saved = JSON.parse(localStorage.getItem(appearanceKey) || 'null') || {};
            return normalizeAppearance(saved);
          } catch {
            return { ...appearanceDefaults };
          }
        };
        const saveAppearance = function (settings) {
          const normalized = normalizeAppearance(settings);
          localStorage.setItem(appearanceKey, JSON.stringify(normalized));
          return normalized;
        };
        const applyAppearance = function (settings) {
          const normalized = normalizeAppearance(settings);
          const root = document.documentElement;
          const hue = normalized.hue;
          const blur = normalized.blur;
          const backgroundOpacity = normalized.backgroundOpacity / 100;
          const cardOpacity = normalized.cardOpacity / 100;
          const dark = root.classList.contains('dark');
          const defaultHue = hue === appearanceDefaults.hue;
          root.toggleAttribute('data-appearance-custom-hue', !defaultHue);
          const colors = dark
            ? defaultHue
              ? { main: '14, 25, 48', article: '8, 18, 36', sub: '30, 48, 75', reading: '13, 27, 52', nav: '10, 22, 43', hover: '44, 65, 95', border: '147, 197, 253', minimum: [0.10, 0.78, 0.08, 0.15, 0.10, 0.12, 0.10], recommended: [0.36, 0.78, 0.28, 0.64, 0.38, 0.40, 0.24], maximum: [0.92, 0.94, 0.90, 0.94, 0.90, 0.90, 0.60] }
              : { main: `${hue} 24% 15%`, article: `${hue} 20% 11%`, sub: `${hue} 30% 22%`, reading: `${hue} 26% 16%`, nav: `${hue} 27% 13%`, hover: `${hue} 31% 26%`, border: `${hue} 68% 78%`, minimum: [0.10, 0.78, 0.08, 0.15, 0.10, 0.12, 0.10], recommended: [0.36, 0.78, 0.28, 0.64, 0.38, 0.40, 0.24], maximum: [0.92, 0.94, 0.90, 0.94, 0.90, 0.90, 0.60] }
            : defaultHue
              ? { main: '248, 250, 252', article: '248, 250, 252', sub: '255, 255, 255', reading: '255, 255, 255', nav: '255, 255, 255', hover: '255, 255, 255', border: '255, 255, 255', minimum: [0.08, 0.76, 0.04, 0.12, 0.06, 0.08, 0.12], recommended: [0.30, 0.76, 0.20, 0.42, 0.24, 0.30, 0.52], maximum: [0.94, 0.94, 0.90, 0.92, 0.90, 0.90, 0.82] }
              : { main: `${hue} 40% 98%`, article: `${hue} 34% 99%`, sub: `${hue} 60% 100%`, reading: `${hue} 45% 99%`, nav: `${hue} 60% 100%`, hover: `${hue} 42% 98%`, border: `${hue} 60% 100%`, minimum: [0.08, 0.76, 0.04, 0.12, 0.06, 0.08, 0.12], recommended: [0.30, 0.76, 0.20, 0.42, 0.24, 0.30, 0.52], maximum: [0.94, 0.94, 0.90, 0.92, 0.90, 0.90, 0.82] };
          const alpha = (index) => {
            const [minimum, recommended, maximum] = [colors.minimum[index], colors.recommended[index], colors.maximum[index]];
            const value = cardOpacity <= 0.2
              ? minimum + (recommended - minimum) * (cardOpacity / 0.2)
              : recommended + (maximum - recommended) * ((cardOpacity - 0.2) / 0.8);
            return value.toFixed(3);
          };
          root.style.setProperty('--appearance-hue', String(hue));
          root.style.setProperty('--appearance-background-blur', `${blur}px`);
          root.style.setProperty('--appearance-background-scale', String(1.03 + blur / 350));
          root.style.setProperty('--appearance-background-opacity', String(backgroundOpacity));
          const paint = (color, index) => defaultHue ? `rgba(${color}, ${alpha(index)})` : `hsl(${color} / ${alpha(index)})`;
          root.style.setProperty('--appearance-glass-main', paint(colors.main, 0));
          root.style.setProperty('--appearance-glass-article', paint(colors.article, 1));
          root.style.setProperty('--appearance-glass-sub', paint(colors.sub, 2));
          root.style.setProperty('--appearance-glass-reading', paint(colors.reading, 3));
          root.style.setProperty('--appearance-glass-nav', paint(colors.nav, 4));
          root.style.setProperty('--appearance-glass-sub-hover', paint(colors.hover, 5));
          root.style.setProperty('--appearance-glass-border', paint(colors.border, 6));
          return normalized;
        };
        const resetAppearance = function () {
          localStorage.removeItem(appearanceKey);
          return applyAppearance(appearanceDefaults);
        };
        window.__weltAppearance = {
          defaults: { ...appearanceDefaults },
          read: readAppearance,
          apply: applyAppearance,
          save: saveAppearance,
          reset: resetAppearance,
        };
        const savedTheme = localStorage.getItem('theme');
        const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        applyAppearance(readAppearance());
        window.__weltSyncThemeColor = function () {
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.classList.contains('dark') ? '#0a162b' : '#f8fafc');
        };
        window.__weltSyncThemeColor();
        // 导航入场动画只在首次进入页面时播放，站内切页与刷新不再重复
        if (!sessionStorage.getItem('welt-nav-entered')) {
          try {
            sessionStorage.setItem('welt-nav-entered', '1');
          } catch {
            // 会话存储不可用时，入场动画保持可用
          }
          document.documentElement.classList.add('nav-entering');
        }
      })();
    </script>
    <script is:inline>
      if (!window.__weltRouterLifecycleBound) {
        window.__weltRouterLifecycleBound = true;
        document.addEventListener('astro:before-swap', function (event) {
          var useDark = document.documentElement.classList.contains('dark');
          event.newDocument.documentElement.classList.toggle('dark', useDark);
        });
        document.addEventListener('astro:after-swap', function () {
          window.__weltAppearance?.apply(window.__weltAppearance?.read());
          if (!window.location.hash) window.scrollTo(0, 0);
        });
      }
    </script>
    <ClientRouter />
    <script>
      function mountGiscus() {
        const container = document.getElementById('giscus-container');
        if (!container || container.childElementCount > 0) return;

        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', 'WELT5350/WELT5350.github.io');
        script.setAttribute('data-repo-id', 'R_kgDOSlpBSg');
        script.setAttribute('data-category', 'Guestbook');
        script.setAttribute('data-category-id', 'DIC_kwDOSlpBSs4C9uCh');
        script.setAttribute('data-mapping', 'specific');
        script.setAttribute('data-term', 'guestbook');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-input-position', 'top');
        script.setAttribute('data-theme', 'preferred_color_scheme');
        script.setAttribute('data-lang', 'zh-CN');
        script.crossOrigin = 'anonymous';
        container.appendChild(script);
      }

      document.addEventListener('astro:page-load', mountGiscus);
    </script>
  </head>
  <body class="font-sans text-gray-700 dark:text-gray-300 antialiased min-h-screen flex flex-col bg-white dark:bg-gray-950 transition-colors duration-300">
    <slot />
  </body>
</html>
