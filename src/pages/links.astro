---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="友情链接">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-glass-ink text-2xl md:text-3xl font-bold">友情链接</h1>
      <p class="text-glass-quiet text-sm mt-1">小伙伴们的根据地。</p>
    </div>
    <a href="/" class="text-glass-quiet text-xs hover:text-blue-500 dark:hover:text-blue-400 transition-colors">← 返回首页</a>
  </div>
  <div class="grid md:grid-cols-2 gap-3">
    <a href="https://spartan-x125.github.io/" target="_blank" rel="noopener noreferrer" class="glass-sub flex items-center gap-4 p-4 rounded-xl hover:border-blue-200 dark:hover:border-blue-800 transition-[background-color,border-color,color] group">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">S</div>
      <div class="min-w-0">
        <p class="text-glass-ink text-sm font-medium group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">Spartan_x</p>
        <p class="text-glass-quiet text-xs truncate">我们生而眺望。</p>
      </div>
    </a>
    <div class="glass-sub text-glass-quiet flex items-center justify-center p-8 rounded-xl border-dashed text-sm">
      更多友链等你来交换 ~
    </div>
  </div>
</BlogLayout>
