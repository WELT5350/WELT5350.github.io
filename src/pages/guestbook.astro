---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="留言板">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="glass-sub w-10 h-10 rounded-xl flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <div>
        <h1 class="text-glass-ink text-2xl md:text-3xl font-bold">留言板</h1>
        <p class="text-glass-quiet text-sm mt-1">踩个脚印再走吧 ~</p>
      </div>
    </div>
    <a href="/" class="text-glass-quiet text-xs hover:text-blue-500 dark:hover:text-blue-400 transition-colors">← 返回首页</a>
  </div>
  <div class="h-px bg-gradient-to-r from-transparent via-blue-200/30 dark:via-blue-800/30 to-transparent mb-8"></div>
  <div class="glass-sub p-1 rounded-xl">
    <div id="giscus-container" class="rounded-lg overflow-hidden"></div>
  </div>
</BlogLayout>
