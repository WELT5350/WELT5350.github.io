                  window._typewriterDone = true;
                  var h1 = document.getElementById('typewriter-heading');
                  if (!h1) return;
                  var text = h1.textContent.trim();
                  h1.textContent = '';
                  var cursor = document.createElement('span');
                  cursor.textContent = '\u2502';
                  cursor.style.cssText = 'font-weight:300;margin-left:2px;animation:typewriter-blink 0.8s step-end infinite;';
                  cursor.classList.add('typewriter-cursor');
                  h1.appendChild(cursor);
                  var i = 0;
                  function type() {
                    if (i < text.length) {
                      h1.insertBefore(document.createTextNode(text[i]), cursor);
                      i++;
                      var delay = text[i-1] === '！' ? 300 : (text[i-1] === '你' ? 200 : 90 + Math.random() * 60);
