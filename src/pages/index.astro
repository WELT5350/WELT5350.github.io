---
import BlogLayout from '../layouts/BlogLayout.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, sortPostsByDate, getSiteArchiveStats, formatCompactNumber } from '../lib/posts';

const allPosts = await getCollection('posts');
const posts = sortPostsByDate(getPublishedPosts(allPosts));
const stats = getSiteArchiveStats(posts);
---

<BlogLayout title="首页" bare>
  <!-- 谦逊刊头：个人退后，内容主角 -->
  <div slot="hero" class="w-full max-w-2xl">
    <header class="flex items-center gap-4 border-b border-[var(--glass-border)] pb-6">
      <img class="block h-12 w-12 rounded-full ring-2 ring-white/50 dark:hidden dark:ring-gray-700/50" src="/avatar.webp" alt="WELT 头像" width="48" height="48" fetchpriority="high" />
      <img class="hidden h-12 w-12 rounded-full ring-2 ring-white/50 dark:block dark:ring-gray-700/50" src="/avatar-dark.webp" alt="WELT 头像" width="48" height="48" fetchpriority="high" />
      <div class="min-w-0">
        <p class="accent-brand text-base font-black tracking-[0.25em] bg-clip-text text-transparent">WELT</p>
        <p id="typewriter-heading" class="mt-0.5 text-xs text-glass-muted">
          记录一些学习、想法，和走过的路。
        </p>
      </div>
    </header>

    <div data-night-star-divider class="mt-6 flex items-center gap-4">
      <span class="flex-1 h-0.5 bg-gradient-to-r from-transparent to-gray-300 dark:to-gray-600 rounded-full"></span>
      <button data-night-star type="button" class="night-star-entry" aria-label="夜间入口">✦</button>
      <span class="flex-1 h-0.5 bg-gradient-to-l from-transparent to-gray-300 dark:to-gray-600 rounded-full"></span>
    </div>
  </div>
  <a href="/dream" id="dream-door-link" class="hidden" tabindex="-1" aria-hidden="true"></a>

  <!-- 主编语 -->
  <p class="max-w-xl text-sm leading-relaxed text-glass-muted">
    欢迎来到我的小小角落。这里是 WELT 的写作空间——记录学习过程中的收获、解决过的问题、以及想记住的想法。
  </p>
  <a href="/posts" class="accent-action inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-medium transition-colors">
    浏览文章
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
  </a>

  <!-- 文章列表：编辑式——细线分隔，排版主导，写作即主角 -->
  <section aria-label="文章">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-glass-quiet">文章</h2>
      <a href="/posts" class="text-xs text-glass-quiet transition-colors hover:text-[var(--appearance-accent)]">全部 →</a>
    </div>
    <ul class="divide-y divide-[var(--glass-border)]">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}`} class="group block py-5 transition-colors">
            <div class="flex items-center gap-3">
              <time datetime={post.data.pubDate.toISOString()} class="flex-none text-xs tabular-nums text-glass-quiet">
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="tag text-[10px] px-1.5 py-0.5">{post.data.tags[0]}</span>
              )}
            </div>
            <h3 class="mt-1.5 text-lg font-medium leading-snug text-glass-ink transition-colors group-hover:text-[var(--appearance-accent)]">
              {post.data.title}
            </h3>
            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-glass-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 安静附栏：正在听 + 写作足迹 -->
  <div class="mt-10 grid gap-6 border-t border-[var(--glass-border)] pt-8 sm:grid-cols-2">
    <div>
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-glass-quiet">正在听</h2>
      <MusicPlayer />
    </div>
    <div>
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-glass-quiet">写作足迹</h2>
      <p class="text-sm leading-relaxed text-glass-muted">
        公开文章 <span class="font-semibold text-glass-ink">{stats.postCount}</span> 篇 ·
        标签 <span class="font-semibold text-glass-ink">{stats.tagCount}</span> 个 ·
        累计 <span class="font-semibold text-glass-ink">{formatCompactNumber(stats.totalUnits)}</span> 字
      </p>
      <p class="mt-2 text-xs text-glass-quiet">内容多过装饰，才是这里的样子。</p>
    </div>
  </div>
</BlogLayout>

<script src="../scripts/typewriter.ts"></script>
<script src="../scripts/night-star.ts"></script>
