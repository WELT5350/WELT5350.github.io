              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">S</div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-gray-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">Spartan_x</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 truncate">我们生而眺望。</p>
              </div>
            </a>
            <div class="flex items-center justify-center p-8 rounded-xl bg-white/10 dark:bg-gray-800/20 border border-dashed border-white/30 dark:border-gray-700/30 text-gray-400 dark:text-gray-500 text-sm">
              更多友链等你来交换 ~
            </div>
          </div>
        </div>

        <!-- Pages: Each Post -->
        {renderedPosts.map(({ post, Content, readingTime, prevPost, nextPost }) => (
          <div id={`page-post-${post.id}`} class="spa-page" style="display:none;">
            <div class="flex items-center justify-between mb-8">
              <div class="flex flex-wrap items-center gap-2 text-sm">
                <time datetime={post.data.pubDate.toISOString()} class="text-gray-400 dark:text-gray-500">
                  {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span class="text-blue-200 dark:text-gray-700">·</span>
                <span class="text-gray-400 dark:text-gray-500">{readingTime} 分钟阅读</span>
                {post.data.tags && post.data.tags.length > 0 && (
                  <>
                    <span class="text-blue-200 dark:text-gray-700">·</span>
                    {post.data.tags.map((tag, ti) => (
                      <span class={`tag ${ti % 2 === 0 ? 'tag-light' : 'tag-deep'}`}>{tag}</span>
                    ))}
                  </>
                )}
              </div>
            </div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 tracking-tight leading-tight mb-8">
              {post.data.title}
            </h1>
            <div class="prose-custom">
              <Content />
            </div>
            <div class="mt-10 pt-6 border-t border-white/30 dark:border-gray-700/30">
              <div class="flex items-center justify-between gap-4 mb-4">
                <div class="min-w-0 flex-1">
                  {prevPost ? (
                    <a href={`#post-${prevPost.id}`} onclick={`navigateTo('post-${prevPost.id}'); return false;`} class="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors max-w-full">
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                      <span class="truncate">{prevPost.data.title}</span>
                    </a>
                  ) : <span></span>}
                </div>
                <div class="min-w-0 flex-1 text-right">
                  {nextPost ? (
                    <a href={`#post-${nextPost.id}`} onclick={`navigateTo('post-${nextPost.id}'); return false;`} class="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors max-w-full">
                      <span class="truncate">{nextPost.data.title}</span>
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  ) : <span></span>}
                </div>
              </div>
              <a href="#posts" onclick="navigateTo('posts'); return false;" class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                返回文章列表
              </a>
            </div>
          </div>
        ))}

      </div>
    </div>

  <script is:inline>
    (function() {
      var hash = window.location.hash.replace('#','') || 'home';
      var pages = document.querySelectorAll('.spa-page');
      var validIds = [];
      pages.forEach(function(p) { if (p.id) validIds.push(p.id.replace('page-', '')); });
      if (validIds.indexOf(hash) === -1) hash = 'home';
      pages.forEach(function(p) { p.style.display = 'none'; p.classList.remove('active'); });
      var target = document.getElementById('page-' + hash);
      if (target) {
        target.style.display = 'block';
        target.classList.add('active');
      }
    })();
  </script>
</Layout>
