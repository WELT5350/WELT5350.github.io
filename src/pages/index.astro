---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection, render } from 'astro:content';

const allPosts = await getCollection('posts', (post) => {
  return import.meta.env.DEV ? true : post.data.draft !== true;
});
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 4);
const currentYear = new Date().getFullYear();

const renderedPosts = await Promise.all(posts.map(async (post, index) => {
  const { Content } = await render(post);
  const rawBody = post.body || '';
  const chineseChars = (rawBody.match(/[\u4e00-\u9fff]/g) || []).length;
  const englishWords = (rawBody.match(/[a-zA-Z]+/g) || []).length;
  const readingTime = Math.max(1, Math.ceil(chineseChars / 400 + englishWords / 200));
  const prevPost = index < posts.length - 1 ? posts[index + 1] : null;
  const nextPost = index > 0 ? posts[index - 1] : null;
  return { post, Content, readingTime, prevPost, nextPost };
}));
