---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="页面不存在">
  <div class="flex flex-col items-center justify-center py-16 text-center">
    <div class="text-8xl font-black bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent mb-4">
      404
    </div>
    <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-2">页面不存在</h1>
    <p class="text-gray-400 dark:text-gray-500 text-sm mb-8 max-w-sm">
      你来到了没有知识的荒原……
    </p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 transition-colors shadow-md shadow-blue-600/20">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      返回首页
    </a>
  </div>
</BlogLayout>
